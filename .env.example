# PostgreSQL の接続文字列（postgresql://...）。
# 開発はローカルの Docker（compose.yaml）。ホストは localhost ではなく 127.0.0.1 にする
# （localhost が ::1 に解決されて接続できないことがある）。本番・プレビューは Neon で、環境ごとに分ける
DATABASE_URL=
# Neon の直接接続（Prisma CLI 用）。ローカルでは行ごと消す。
# 空のまま残すと prisma.config.ts の `DIRECT_URL ?? DATABASE_URL` で DATABASE_URL に切り替わらない
DIRECT_URL=

# セッション JWT の署名鍵。十分に長いランダム文字列を設定する
# 例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# パスキーのチャレンジの署名と、ログイン試行の IP ハッシュ（HMAC）にも使う
AUTH_SECRET=

# 定期処理（Vercel Cron → GET /api/cron/cleanup）の認証に使う値。期限切れのデモユーザーと古い記録を消す。
# Vercel はこの環境変数があると、Cron の呼び出しに "Authorization: Bearer <CRON_SECRET>" を付ける。
# 未設定・空なら定期処理は何もせず 401 を返す（誰でも叩ける状態にしない）。
# AUTH_SECRET とは別の値にする。十分に長いランダム文字列を設定する
# 例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# パスキーの RP ID。ホスト名のみでスキームもポートも含めない。
# 本番は "<project>.vercel.app"、ローカル開発は "localhost"
RP_ID=

# パスキーで許可するオリジン。スキームとポートを含める。
# 本番は "https://<project>.vercel.app"、ローカル開発は "http://localhost:3000"
RP_ORIGIN=

# 開発サーバーを同じ LAN のスマホなどから開くときの、PC の IP（カンマ区切りで複数可）。例: 192.168.x.x
# 開発時だけ使う。本番（Vercel）では設定しない。未設定なら localhost 以外からは開けない。
# http の IP ではパスキーは動かない（見た目の確認用）
DEV_ALLOWED_ORIGINS=
