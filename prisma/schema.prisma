// Prisma schema
// 参照: https://pris.ly/d/prisma-schema
//
// 仕様の出典: docs/features.md / docs/steps/step-2.md / docs/steps/pub-1.md / docs/steps/pub-2.md / docs/steps/pub-3.md
//
// 共通規約
// - 全データモデルに userId（User への参照、onDelete: Cascade）を持たせる。
//   例外は3つ:
//   - LoginAttempt（ログイン前＝誰か分からない時点の IP 単位の記録のため）
//   - SignupEvent（サインアップのレート制限の記録。ユーザーに紐づけて Cascade にすると、
//     アカウントを消すたびに記録も消え「作って消す」の繰り返しで制限を回避できるため。
//     docs/steps/pub-2.md 設計判断 5）
//   - DemoEvent（デモアカウント作成のレート制限の記録。SignupEvent と同じ理由で userId を持たない。
//     デモユーザーは期限切れで削除されるので、紐づけると削除のたびに記録も消えて制限が効かなくなる。
//     docs/steps/pub-3.md 設計判断 4）
//   Budget / CategoryBudget も払い出し先・カテゴリ経由で持ち主が決まるが、直接 userId を持たせる
//   （「全クエリの where に userId がある」という単純な規則にするため）
// - 関連の持ち主は複合外部キー（[関連ID, userId] → 参照先の [id, userId]）で DB に強制する。
//   他人のカテゴリ・払い出し先を参照する行は外部キー違反で拒否される
// - 金額はすべて整数円（Int）。小数は使わない
// - 年月は String の "YYYY-MM" 形式（@db.VarChar(7)）。辞書順ソートが暦順と一致する。
//   char(7) は末尾を空白で埋めてしまい（"2026-8" → "2026-8 "）JS 側の === 比較が
//   静かに失敗するため varchar(7) を使う。長さ上限だけを DB で保証し、
//   "YYYY-MM" という形式そのものの保証はアプリ層の整形ヘルパーの責任とする
// - 全モデルに createdAt / updatedAt、id は cuid

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // 部分ユニークインデックス（PaymentSource.isDefault が true の行は最大1件）に必要。
  // Prisma 7.9.1 では preview feature。
  previewFeatures = ["partialIndexes"]
}

// 接続URLは prisma.config.ts の datasource.url が環境変数から読む。
// Prisma 7 では schema 側の `url = env("DATABASE_URL")` はサポートされない（P1012）。
datasource db {
  provider = "postgresql"
}

/// 払い出し先のタイプ（features.md「払い出し先のタイプは3種類」）
enum PaymentSourceType {
  CASH
  CREDIT_CARD
  BANK_DEBIT
}

/// 浪費フラグ（features.md「必要・浪費・投資 の3択」）
enum WasteTag {
  NECESSARY
  WASTE
  INVESTMENT
}

/// カテゴリの固定費/変動費属性
enum CostType {
  FIXED
  VARIABLE
}

/// 利用者。最小限の項目だけを持つ（表示名・メールアドレス等は持たない。docs/steps/pub-1.md 設計判断 2）。
/// 削除すると全データがカスケード削除される。
model User {
  id String @id @default(cuid())

  /// WebAuthn のユーザーID（user handle）。32バイトの暗号学的乱数を base64url にした文字列。
  /// 内部の id（cuid）を認証器へ渡さないため別に持つ。ログイン時に応答の userHandle と照合する
  /// （docs/steps/pub-2.md 設計判断 3・4）。作るのは src/lib/webauthn-user-id.ts の generateWebauthnUserId だけ
  webauthnUserId String @unique

  /// デモユーザーの期限。null なら通常のユーザー、値があればデモユーザーで、この時刻に期限が切れる
  /// （docs/steps/pub-3.md 設計判断 1）。
  /// 「デモかどうか」の真偽値を別に持たない（期限の無いデモ・期限のある通常ユーザーを作れない形にする）。
  /// **作成時に決め、以後変えない。** 延長・デモと通常の切り替えの経路を作らない。
  /// 期限切れの行は定期処理（src/lib/cleanup.ts）が削除する
  demoExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentSources  PaymentSource[]
  categories      Category[]
  expenses        Expense[]
  budgets         Budget[]
  categoryBudgets CategoryBudget[]
  incomes         Income[]
  credentials     Credential[]

  /// 期限切れのデモユーザーの検索用
  @@index([demoExpiresAt])
}

/// 払い出し先。支出を「どこから出したか」で管理する軸であり、月次予算の主軸。
model PaymentSource {
  id   String            @id @default(cuid())
  /// 表示名。例「現金」「Aカード」「A銀行 引き落とし」。ユーザー内で一意
  name String
  type PaymentSourceType

  /// 並べ替え用
  sortOrder Int
  /// 使わなくなったカードの無効化（削除ではない）
  isActive  Boolean @default(true)
  /// 入力時の既定の払い出し先。ユーザーごとに1件のみ true（下の部分ユニークインデックスで強制）
  isDefault Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
  budgets  Budget[]

  /// 複合外部キー（Expense / Budget → [id, userId]）の参照先
  @@unique([id, userId])
  @@unique([userId, name])
  /// isDefault = true の行はユーザーごとに最大1件しか存在できない
  @@unique([userId, isDefault], where: { isDefault: true })
}

/// 支出カテゴリ。
model Category {
  id       String   @id @default(cuid())
  /// ユーザー内で一意
  name     String
  costType CostType

  sortOrder Int
  /// 非表示（削除ではない）
  isHidden  Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
  budgets  CategoryBudget[]

  /// 複合外部キー（Expense / CategoryBudget → [id, userId]）の参照先
  @@unique([id, userId])
  @@unique([userId, name])
}

/// 支出。date は「支出発生日」。
/// クレジットカードも締め日・引き落とし日ではなく発生日で計上する
/// （features.md「設計判断 > クレジットカードの計上タイミング」）。
model Expense {
  id String @id @default(cuid())

  /// 支出発生日。日付のみを保持しタイムゾーンの影響を受けないようにする
  date      DateTime @db.Date
  amountYen Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 複合外部キー。同じ userId のカテゴリしか参照できない
  categoryId String
  category   Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)

  /// 複合外部キー。同じ userId の払い出し先しか参照できない
  paymentSourceId String
  paymentSource   PaymentSource @relation(fields: [paymentSourceId, userId], references: [id, userId], onDelete: Restrict)

  /// 店名。直近使った店名のサジェストに使う
  storeName String?
  memo      String?
  /// 無駄使い検出の中核。nullable にしない
  wasteTag  WasteTag

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, date, categoryId])
  @@index([userId, date, paymentSourceId])
}

/// 払い出し先の月次予算（＝予算の主軸。合計が今月の総予算）。
model Budget {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 複合外部キー。同じ userId の払い出し先しか参照できない
  paymentSourceId String
  paymentSource   PaymentSource @relation(fields: [paymentSourceId, userId], references: [id, userId], onDelete: Cascade)

  /// "YYYY-MM"
  yearMonth String @db.VarChar(7)
  amountYen Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 払い出し先が持ち主を決めるので userId は含めない（操作の where には userId を足す）
  @@unique([paymentSourceId, yearMonth])
  @@index([userId, yearMonth])
}

/// カテゴリの月次予算（＝任意の補助上限。未設定でも全機能が成立する）。
model CategoryBudget {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 複合外部キー。同じ userId のカテゴリしか参照できない
  categoryId String
  category   Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Cascade)

  /// "YYYY-MM"
  yearMonth String @db.VarChar(7)
  amountYen Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// カテゴリが持ち主を決めるので userId は含めない（操作の where には userId を足す）
  @@unique([categoryId, yearMonth])
  @@index([userId, yearMonth])
}

/// 収入。「今月使える原資」としてのみ扱い、収支管理はしない。
/// 1ヶ月に複数件登録できるためユニーク制約は付けない。
model Income {
  id String @id @default(cuid())

  /// "YYYY-MM"
  yearMonth String @db.VarChar(7)
  amountYen Int
  /// 「給与」「賞与」など
  label     String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, yearMonth])
}

/// パスキー（WebAuthn）の資格情報。持ち主（userId）を持つ。
/// ログインは認証器が返した credentialId で引き、その持ち主のセッションを発行する。
model Credential {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 認証器が発行した資格情報ID。base64url 文字列として保存する。
  /// 全体で一意（ログイン時は持ち主が分からない状態で引くため、userId を含めない）
  credentialId String @unique
  /// 公開鍵（COSE 形式のバイト列）
  publicKey    Bytes
  /// 署名カウンタ。クローン検知に使う。0 のままの認証器もある
  counter      BigInt   @default(0)
  /// "internal" / "hybrid" など。次回の認証UIのヒントに使う
  transports   String[]
  /// 「iPhone」など利用者が付ける名前。どの端末を消すのか分かるようにする
  deviceName   String   @db.VarChar(30)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  @@index([userId])
}

/// ログイン試行の記録。レート制限と、攻撃に気づくために残す。
///
/// **userId を持たない唯一のデータモデル。** ログイン前（誰か分からない時点）の IP 単位の記録のため。
///
/// 冒頭の共通規約「全モデルに createdAt / updatedAt」の唯一の例外で updatedAt を持たない。
/// 追記しかせず、書き込んだ行を更新することがないため
/// （更新できると「失敗を成功に書き換える」経路を作ることにもなる）。
model LoginAttempt {
  id String @id @default(cuid())

  /// IP を AUTH_SECRET で HMAC-SHA256 したもの。生IPは保存しない
  ipHash    String
  succeeded Boolean

  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

/// サインアップの記録。サインアップのレート制限（IP 単位・全体）に使う（docs/steps/pub-2.md 設計判断 5）。
///
/// **userId を持たない2つ目のデータモデル**（LoginAttempt に続く例外）。
/// ユーザーに紐づけて Cascade にすると、アカウントを消すたびに記録も消え、
/// 「作って消す」を繰り返せば制限を回避できるため。
///
/// ユーザー作成と同じトランザクションで1件書くので、作られたアカウントの数と記録の数は一致する。
/// LoginAttempt と同じく追記のみで updatedAt を持たない。
model SignupEvent {
  id String @id @default(cuid())

  /// IP を AUTH_SECRET で HMAC-SHA256 したもの。生IPは保存しない
  ipHash String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash, createdAt])
}

/// デモアカウント作成の記録。デモ作成のレート制限（IP 単位・全体）に使う（docs/steps/pub-3.md 設計判断 4）。
///
/// **userId を持たない3つ目のデータモデル**（LoginAttempt・SignupEvent に続く例外）。
/// デモユーザーは期限切れで削除されるので、紐づけて Cascade にすると記録も消え、制限が効かなくなるため。
///
/// SignupEvent とは分ける。デモの連打でサインアップの枠が埋まる（逆も同じ）のを避けるため。
/// デモユーザー作成と同じトランザクションで1件書く。追記のみで updatedAt を持たない。
/// 保持期間（7日）を過ぎた行は定期処理（src/lib/cleanup.ts）が削除する。
model DemoEvent {
  id String @id @default(cuid())

  /// IP を AUTH_SECRET で HMAC-SHA256 したもの。生IPは保存しない
  ipHash String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash, createdAt])
}
